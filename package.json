{
  "name": "pfmt",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro build && node scripts/prune-unpublished.mjs dist && pagefind --site dist --output-subdir pagefind",
    "preview:build": "scripts/preview-build",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "check": "ASTRO_TELEMETRY_DISABLED=1 astro check",
    "test": "node --test src/lib/*.test.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.1.6",
    "astro": "^7.4.13",
    "shiki": "^4.6.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@playwright/test": "^1.65.1",
    "pagefind": "^1.6.0",
    "typescript": "^6.0.3"
  }
}
